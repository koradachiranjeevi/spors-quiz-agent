# OpenAI Credentials (Required for OpenAI embeddings; optional for LLM)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider Configuration
# Supported providers: groq, together, ollama, openai, openai_compatible
LLM_PROVIDER=groq

# API Keys depending on the provider selected
# If using groq:
GROQ_API_KEY=your_groq_api_key_here
# If using together:
TOGETHER_API_KEY=your_together_api_key_here

# Custom Base URL & Model Name (especially for local ollama or custom compatible servers)
# Examples:
# For Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1
# For Groq: LLM_MODEL=llama-3.1-8b-instant
# For Together: LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
LLM_BASE_URL=
LLM_MODEL=llama-3.1-8b-instant

# Embeddings Config
# If set to local, it will use sentence-transformers locally (no API key required)
# If set to openai, it will use OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=openai
